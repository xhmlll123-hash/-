.page {
  --font-kai: "Kaiti SC", "STKaiti", "KaiTi", serif;
  --ink: #1f1a14;
  --ink-soft: #4a3f33;
  --ink-mute: #7a6f5e;
  --paper: #f6ecd5;
  --paper-soft: #faf3e3;
  --paper-deep: #ede1bf;
  --bronze: #a98951;
  --bronze-soft: #c8a974;
  --bronze-line: rgba(169, 137, 81, 0.32);
  --bronze-bg: rgba(169, 137, 81, 0.08);
  --vermillion: #c43d3d;
  --vermillion-deep: #9c1f1f;
  --vermillion-bg: rgba(196, 61, 61, 0.12);
  --page-bg:
    radial-gradient(circle at 18% 10%, rgba(196, 61, 61, 0.07) 0 2rpx, transparent 3rpx),
    linear-gradient(90deg, rgba(138, 106, 50, 0.055) 1rpx, transparent 1rpx),
    linear-gradient(0deg, rgba(138, 106, 50, 0.04) 1rpx, transparent 1rpx),
    linear-gradient(180deg, #f9f1d9 0%, #f1e3c0 100%);
  --page-bg-size: 180rpx 180rpx, 56rpx 56rpx, 56rpx 56rpx, auto;
  --surface: #fffefa;
  --hero-mark: rgba(196, 61, 61, 0.1);
  --panel-pattern:
    linear-gradient(135deg, rgba(138, 106, 50, 0.05) 25%, transparent 25% 50%, rgba(138, 106, 50, 0.035) 50% 75%, transparent 75%);
  --panel-pattern-size: 44rpx 44rpx;
  --result-card-bg:
    radial-gradient(ellipse at 50% 94%, rgba(138, 106, 50, 0.16) 0 8%, transparent 33%),
    linear-gradient(180deg, #fdf6e1 0%, #f1e0b3 100%);
  --result-card-bg-size: auto, auto;
  --shadow-paper: 0 10rpx 24rpx rgba(80, 56, 24, 0.08);
  --shadow-seal: 0 4rpx 14rpx rgba(156, 31, 31, 0.22);

  min-height: 100vh;
  padding: 32rpx 32rpx 112rpx;
  box-sizing: border-box;
  background: var(--page-bg);
  background-size: var(--page-bg-size);
  color: var(--ink);
  font-family: var(--font-kai);
  font-weight: 900;
}

.page button::after {
  border: 0;
}

button {
  margin: 0;
  padding: 0;
  width: auto;
  min-width: 0;
  max-width: none;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-family: var(--font-kai);
  font-weight: 900;
  line-height: 1.2;
  box-sizing: border-box;
  text-align: center;
}

.topbar,
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.topbar {
  margin-bottom: 20rpx;
}

.flow-topbar {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr) 112rpx;
  align-items: center;
  min-height: 76rpx;
  gap: 8rpx;
}

.topbar-title {
  min-width: 0;
  text-align: center;
}

.nav-button {
  justify-self: start;
  margin: 0;
  padding: 0;
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  height: 58rpx;
  color: var(--ink);
  background: var(--surface);
  border: 1rpx solid rgba(169, 137, 81, 0.28);
  border-radius: 14rpx;
  font-family: var(--font-kai);
  font-size: 23rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.topbar-placeholder {
  justify-self: end;
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  height: 58rpx;
}

.home-shell {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.home-hero {
  position: relative;
  min-height: auto;
  display: block;
  padding: 8rpx 0 0;
  z-index: 1;
  overflow: hidden;
}

.home-hero::after {
  content: '六象';
  position: absolute;
  right: 10rpx;
  bottom: 6rpx;
  color: rgba(196, 61, 61, 0.035);
  font-size: 64rpx;
  line-height: 1;
  letter-spacing: 10rpx;
  pointer-events: none;
  z-index: -1;
}

.home-copy {
  min-width: 0;
}

.home-title-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 116rpx;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.home-title {
  margin-top: 0;
  color: var(--ink);
  font-family: var(--font-kai);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: 2rpx;
}

.home-subtitle {
  max-width: 470rpx;
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-family: var(--font-kai);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.45;
}

.library-button {
  justify-self: end;
  width: 116rpx;
  min-width: 116rpx;
  max-width: 116rpx;
  height: 58rpx;
  margin-top: 0;
  padding: 0;
  border-radius: 16rpx;
  font-size: 23rpx;
}

.quick-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 28rpx 20rpx 20rpx;
  background-color: var(--paper-soft);
  background-image: var(--panel-pattern);
  background-size: var(--panel-pattern-size);
  border: 1rpx solid var(--bronze);
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(80, 56, 24, 0.045);
  overflow: hidden;
}

.quick-panel::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 1rpx solid rgba(169, 137, 81, 0.1);
  border-radius: 12rpx;
  pointer-events: none;
}

.quick-knot {
  position: absolute;
  top: 12rpx;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(circle, var(--paper-soft) 0 38%, var(--bronze) 42% 54%, transparent 58%);
  box-shadow: 0 -28rpx 0 -10rpx var(--vermillion-deep);
}

.quick-title {
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.2;
  letter-spacing: 4rpx;
}

.quick-subtitle {
  margin-top: 6rpx;
  max-width: 560rpx;
  color: var(--ink-mute);
  font-size: 24rpx;
  line-height: 1.4;
}

.quick-code-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  margin-top: 14rpx;
  box-sizing: border-box;
}

.quick-code-card {
  flex: 1;
  min-height: 88rpx;
  padding: 12rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  background: var(--surface);
  border: 1rpx solid var(--bronze-line);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.quick-code-number {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--paper-soft);
  background: linear-gradient(135deg, var(--vermillion) 0%, var(--vermillion-deep) 100%);
  border-radius: 8rpx;
  box-shadow: var(--shadow-seal);
  font-size: 26rpx;
  letter-spacing: 0;
}

.quick-code-text {
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.25;
}

.quick-input {
  height: 76rpx;
  flex: 1;
  padding: 0 22rpx;
  color: var(--ink);
  background: var(--surface);
  border: 2rpx solid var(--bronze-line);
  border-radius: 14rpx;
  box-sizing: border-box;
  font-family: var(--font-kai);
  font-weight: 900;
}

.home-error {
  margin-top: 0;
}

.home-section {
  margin-top: 4rpx;
}

.home-section-note {
  margin-top: 8rpx;
  color: var(--ink-mute);
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 24rpx;
  line-height: 1.4;
}

.section-kicker {
  color: var(--bronze);
  font-size: 24rpx;
  letter-spacing: 6rpx;
}

.home-template-grid {
  margin-top: 10rpx;
}

.home-template-card {
  position: relative;
  min-height: 126rpx;
  padding-top: 26rpx;
}

.template-seal {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  min-width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--paper-soft);
  background: var(--vermillion);
  border-radius: 6rpx;
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 0;
}

.eyebrow {
  color: var(--bronze);
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.label {
  color: var(--bronze);
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.muted {
  color: var(--ink-mute);
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 24rpx;
}

.title {
  margin-top: 4rpx;
  color: var(--ink);
  font-family: var(--font-kai);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.panel {
  margin-top: 28rpx;
  padding: 40rpx 28rpx 28rpx;
  background:
    linear-gradient(180deg, rgba(255, 252, 242, 0.72), rgba(250, 243, 227, 0.88)),
    linear-gradient(135deg, rgba(138, 106, 50, 0.025) 25%, transparent 25% 50%, rgba(138, 106, 50, 0.018) 50% 75%, transparent 75%);
  background-size: auto, 48rpx 48rpx;
  border: 1rpx solid rgba(169, 137, 81, 0.22);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(80, 56, 24, 0.07);
  position: relative;
  overflow: hidden;
}

.panel::before {
  content: '';
  position: absolute;
  inset: 18rpx;
  border: 1rpx solid rgba(169, 137, 81, 0.14);
  border-radius: 16rpx;
  pointer-events: none;
}

.edit-panel {
  padding: 36rpx 28rpx 24rpx;
}

.edit-panel .section-title,
.edit-panel .muted,
.edit-panel .input-panel,
.edit-panel .chip-section,
.edit-panel .excluded-box,
.edit-panel .error,
.edit-panel .primary-button {
  position: relative;
  z-index: 1;
}

.section-title {
  color: var(--ink);
  font-family: var(--font-kai);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.template-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.template-card {
  width: auto;
  min-height: 124rpx;
  padding: 18rpx;
  text-align: left;
  border: 1rpx solid var(--bronze-line);
  border-radius: 14rpx;
  background: #fffefa;
  box-sizing: border-box;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.7);
}

.template-name {
  font-family: var(--font-kai);
  font-size: 26rpx;
  font-weight: 900;
  color: var(--ink);
}

.template-desc {
  margin-top: 6rpx;
  color: var(--ink-mute);
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 21rpx;
  line-height: 1.35;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.input-panel {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  padding: 14rpx;
  background: rgba(255, 254, 250, 0.62);
  border: 1rpx solid rgba(169, 137, 81, 0.2);
  border-radius: 18rpx;
}

.input-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 108rpx;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.input-panel .input-row {
  margin-top: 0;
  align-items: stretch;
}

.option-input {
  min-width: 0;
  height: 78rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(169, 137, 81, 0.24);
  border-radius: 14rpx;
  background: #fffefa;
  color: var(--ink);
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 25rpx;
  box-sizing: border-box;
}

.small-button,
.ghost-button,
.link-button,
.danger-button {
  margin: 0;
  padding: 0 18rpx;
  border-radius: 14rpx;
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
}

.small-button {
  width: 108rpx;
  min-width: 108rpx;
  max-width: 108rpx;
  height: 78rpx;
  padding: 0;
  color: var(--ink);
  background: rgba(169, 137, 81, 0.075);
  border: 1rpx solid rgba(120, 92, 45, 0.24);
  border-radius: 14rpx;
}

.ghost-button,
.secondary-button {
  color: var(--ink);
  background: #fffefa;
  border: 1rpx solid var(--bronze-line);
}

.home-hero .library-button {
  width: 116rpx;
  min-width: 116rpx;
  max-width: 116rpx;
  height: 58rpx;
  padding: 0;
}

.chip-section {
  margin-top: 22rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.chip {
  width: auto;
  margin: 0;
  padding: 8rpx 16rpx;
  min-height: 46rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 22rpx;
  line-height: 1.2;
  word-break: break-word;
  overflow-wrap: anywhere;
  border: 1rpx solid rgba(169, 137, 81, 0.28);
  box-sizing: border-box;
  max-width: 100%;
  flex: 0 1 auto;
}

.selected-chip {
  color: var(--ink);
  background: rgba(237, 225, 191, 0.88);
  border-color: rgba(169, 137, 81, 0.48);
}

.selected-chip-row,
.history-chip-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: flex-start;
  gap: 10rpx;
}

.selected-chip-row .chip,
.history-chip-row .chip,
.excluded-chip-row .chip {
  width: auto;
  min-width: 0;
  max-width: 100%;
  min-height: 60rpx;
  padding: 12rpx 22rpx;
  font-size: 25rpx;
  flex: 0 1 auto;
  text-align: left;
}

.history-chip {
  color: rgba(74, 63, 51, 0.72);
  background: rgba(255, 254, 250, 0.72);
  border-color: rgba(169, 137, 81, 0.26);
}

.example-chip {
  color: rgba(74, 63, 51, 0.7);
  background: rgba(255, 254, 250, 0.62);
  border-color: rgba(169, 137, 81, 0.24);
}

.excluded-box,
.error,
.empty {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 25rpx;
}

.excluded-box {
  background: rgba(245, 241, 235, 0.6);
  border: 2rpx solid rgba(225, 215, 195, 0.4);
}

.excluded-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.excluded-title {
  color: rgba(140, 118, 87, 0.9);
  font-size: 25rpx;
}

.excluded-restore {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(196, 61, 61, 0.25);
  color: rgba(196, 61, 61, 0.85);
  background: rgba(196, 61, 61, 0.04);
  font-size: 23rpx;
  font-weight: bold;
}

.excluded-chip-row {
  margin-top: 16rpx;
}

.excluded-chip {
  color: rgba(140, 118, 87, 0.85);
  background: rgba(246, 237, 219, 0.4);
  border-color: rgba(225, 211, 188, 0.6);
}

.error {
  color: rgba(196, 61, 61, 0.85);
  background: rgba(255, 244, 242, 0.8);
  border: 2rpx solid rgba(196, 61, 61, 0.12);
}

.empty {
  color: var(--ink-mute);
  background: var(--bronze-bg);
  border: 2rpx solid var(--bronze-line);
}

.link-button {
  margin-left: 12rpx;
  color: var(--vermillion);
  background: transparent;
}

.primary-button,
.secondary-button {
  width: 100%;
  height: 82rpx;
  margin-top: 18rpx;
  border-radius: 16rpx;
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 27rpx;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-button {
  color: var(--paper-soft);
  background: var(--ink);
}

.edit-panel > .primary-button,
.edit-primary-button {
  display: flex;
  align-self: stretch;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-top: 22rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.history-section {
  margin-top: 26rpx;
}

.history-section .label {
  color: rgba(122, 111, 94, 0.82);
}


.quick-panel .quick-button {
  align-self: stretch;
  flex: 0 0 auto;
  display: flex;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 80rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

/* ========== Result panel ========== */
.result-panel {
  text-align: center;
  padding: 20rpx;
}

.result-eyebrow {
  color: var(--bronze);
  font-size: 20rpx;
  letter-spacing: 6rpx;
  opacity: 0.68;
}

.result-headline {
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.pool-preview {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 10rpx 0 4rpx;
  text-align: left;
}

.pool-block {
  padding: 12rpx 14rpx;
  background: rgba(169, 137, 81, 0.03);
  border: 1rpx solid rgba(169, 137, 81, 0.14);
  border-radius: 14rpx;
}

.pool-block .label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  color: rgba(122, 111, 94, 0.76);
}

.pool-block .label::before {
  content: '';
  display: inline-block;
  width: 3rpx;
  height: 16rpx;
  background: var(--vermillion);
  opacity: 0.58;
}

.mini-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.mini-chip {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.2;
  background: var(--paper-soft);
  border: 1rpx solid var(--bronze-line);
  color: var(--ink-mute);
  word-break: break-word;
  overflow-wrap: anywhere;
  transition: background 90ms ease, border-color 90ms ease, color 90ms ease, transform 90ms ease;
}

.mini-chip-flash {
  background: var(--vermillion-bg);
  border-color: var(--vermillion);
  color: var(--ink);
  transform: scale(1.05);
  box-shadow: 0 0 0 2rpx rgba(196, 61, 61, 0.18);
}

.mini-chip-active {
  background: var(--vermillion-bg);
  border-color: rgba(196, 61, 61, 0.52);
  color: var(--vermillion-deep);
  box-shadow: none;
  animation: settle-pulse 320ms cubic-bezier(0.3, 1.4, 0.5, 1);
}

.symbol-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 7rpx;
}

.six-symbol {
  min-width: 0;
  min-height: 64rpx;
  padding: 7rpx 5rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: var(--paper-soft);
  border: 1rpx solid var(--bronze-line);
  border-radius: 10rpx;
  font-family: var(--font-kai);
  font-size: 23rpx;
  font-weight: 900;
  color: var(--ink-soft);
  letter-spacing: 4rpx;
  transition: background 90ms ease, border-color 90ms ease, color 90ms ease, transform 90ms ease;
  box-sizing: border-box;
}

.six-symbol-text {
  display: inline-block;
}

.six-symbol-options {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6rpx;
  letter-spacing: 0;
}

.six-symbol-option {
  max-width: 100%;
  padding: 1rpx 7rpx;
  border-radius: 999rpx;
  color: var(--ink-mute);
  background: rgba(255, 254, 250, 0.72);
  font-family: var(--font-kai);
  font-size: 17rpx;
  font-weight: 500;
  line-height: 1.35;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.six-symbol-option-active {
  color: var(--vermillion-deep);
  background: var(--paper-soft);
  font-weight: 700;
}

.six-symbol-flash {
  background: var(--vermillion-bg);
  border-color: var(--vermillion);
  color: var(--ink);
  transform: scale(1.06);
  box-shadow: 0 0 0 2rpx rgba(196, 61, 61, 0.2);
}

.reveal-off .mini-chip,
.reveal-off .six-symbol {
  transition: none;
}

.reveal-off .mini-chip-flash {
  background: var(--paper-soft);
  border-color: var(--bronze-line);
  color: var(--ink-mute);
  transform: none;
  box-shadow: none;
}

.reveal-off .six-symbol-flash {
  background: var(--paper-soft);
  border-color: var(--bronze-line);
  color: var(--ink-soft);
  transform: none;
  box-shadow: none;
}

.six-symbol-active {
  background: rgba(196, 61, 61, 0.16);
  border-color: rgba(196, 61, 61, 0.48);
  color: var(--vermillion-deep);
  box-shadow: none;
  animation: settle-pulse 360ms cubic-bezier(0.3, 1.4, 0.5, 1);
}

.six-symbol-active .six-symbol-option {
  color: var(--ink-soft);
  background: rgba(255, 254, 250, 0.74);
}

.six-symbol-active .six-symbol-option-active {
  color: var(--vermillion-deep);
  background: var(--paper-soft);
}

@keyframes settle-pulse {
  0% { transform: scale(1.2); }
  60% { transform: scale(0.96); }
  100% { transform: scale(1); }
}

/* Reveal block */
.reveal-block {
  margin-top: 0;
  opacity: 1;
  transform: translateY(0);
}

.reveal-on {
  opacity: 1;
  transform: translateY(0);
}

.result-card {
  position: relative;
  margin: 0 0 8rpx;
  padding: 50rpx 24rpx 32rpx;
  border-radius: 16rpx;
  background: var(--result-card-bg);
  background-size: var(--result-card-bg-size);
  border: 1rpx solid var(--bronze);
  color: var(--ink);
  word-break: break-word;
  overflow-wrap: anywhere;
  overflow: hidden;
}

.result-card::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 1rpx solid rgba(169, 137, 81, 0.24);
  border-radius: 10rpx;
  pointer-events: none;
}

.result-card::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  width: 22rpx;
  height: 22rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(circle, #f9f1d9 0 38%, #8a6a32 42% 54%, transparent 58%);
  box-shadow: 0 -28rpx 0 -10rpx var(--vermillion-deep);
  opacity: 0.76;
}

.result-note {
  margin: 10rpx 0 0;
  color: var(--ink-mute);
  font-family: var(--font-kai);
  font-weight: 900;
  font-size: 23rpx;
  line-height: 1.4;
}

.result-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin: 14rpx 0 16rpx;
}

.result-actions .primary-button,
.result-actions .secondary-button {
  height: 76rpx;
  margin-top: 0;
  letter-spacing: 2rpx;
}

.symbol-seal {
  display: inline-block;
  min-width: 112rpx;
  padding: 12rpx 22rpx;
  background: linear-gradient(135deg, var(--vermillion) 0%, var(--vermillion-deep) 100%);
  color: var(--paper-soft);
  font-family: var(--font-kai);
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  border-radius: 6rpx;
  box-shadow: var(--shadow-seal);
}

.reveal-on .symbol-seal {
  animation: seal-stamp 380ms cubic-bezier(0.34, 1.56, 0.64, 1) 80ms backwards;
}

@keyframes seal-stamp {
  0% { transform: scale(0.4) rotate(-6deg); opacity: 0; }
  60% { transform: scale(1.1) rotate(2deg); opacity: 1; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}

.result-option {
  margin-top: 18rpx;
  color: var(--ink);
  font-family: var(--font-kai);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.result-message {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-family: var(--font-kai);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.5;
}

.rank-block {
  margin: 10rpx 0 16rpx;
  padding: 12rpx 14rpx;
  background: rgba(169, 137, 81, 0.03);
  border: 1rpx solid rgba(169, 137, 81, 0.14);
  border-radius: 14rpx;
  text-align: left;
}

.rank-block .label {
  margin-bottom: 10rpx;
}

.rank-row {
  display: grid;
  grid-template-columns: 42rpx 1fr 42rpx;
  align-items: center;
  gap: 10rpx;
  min-height: 58rpx;
  padding: 7rpx;
  border-radius: 10rpx;
  color: var(--ink-soft);
  font-size: 23rpx;
}

.rank-row-primary {
  color: var(--vermillion-deep);
  background: var(--vermillion-bg);
}

.rank-index,
.rank-score {
  text-align: center;
  font-weight: 700;
}

.rank-main {
  min-width: 0;
}

.rank-option {
  color: inherit;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.rank-hint {
  margin-top: 4rpx;
  color: var(--ink-mute);
  font-family: var(--font-kai);
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.rank-row-primary .rank-hint {
  color: rgba(156, 31, 31, 0.7);
}

.result-support {
  margin-top: 12rpx;
  opacity: 0.74;
}

.result-meta {
  color: var(--ink-mute);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.result-disclaimer {
  margin-top: 8rpx;
  color: var(--ink-mute);
  font-size: 22rpx;
  line-height: 1.4;
}

.reflection-quote {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  color: var(--ink-soft);
  background: rgba(255, 254, 250, 0.44);
  border-left: 6rpx solid var(--bronze);
  border-radius: 10rpx;
  font-size: 23rpx;
  line-height: 1.55;
  text-align: left;
}

.reflection-source {
  margin-top: 8rpx;
  color: var(--ink-mute);
  font-size: 21rpx;
  text-align: right;
}

.acceptance-cover {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  min-height: 100vh;
  padding: 56rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--page-bg);
  background-size: var(--page-bg-size);
  animation: acceptance-fade 180ms ease-out;
}

.acceptance-shell {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  min-height: 620rpx;
  padding: 54rpx 34rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: var(--paper-soft);
  background-image: var(--panel-pattern);
  background-size: var(--panel-pattern-size);
  border: 2rpx solid var(--bronze);
  border-radius: 22rpx;
  box-shadow: var(--shadow-paper);
  box-sizing: border-box;
  overflow: hidden;
  animation: acceptance-rise 240ms ease-out;
}

.acceptance-shell::before {
  content: '';
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  border: 1rpx solid var(--bronze-line);
  border-radius: 16rpx;
  pointer-events: none;
}

.acceptance-mark {
  min-width: 112rpx;
  padding: 14rpx 28rpx;
  color: var(--paper-soft);
  background: linear-gradient(135deg, var(--vermillion) 0%, var(--vermillion-deep) 100%);
  border-radius: 6rpx;
  box-shadow: var(--shadow-seal);
  font-size: 28rpx;
  line-height: 1;
  letter-spacing: 8rpx;
}

.acceptance-eyebrow {
  margin-top: 34rpx;
  color: var(--bronze);
  font-size: 22rpx;
  letter-spacing: 8rpx;
}

.acceptance-choice {
  max-width: 100%;
  margin-top: 18rpx;
  color: var(--ink);
  font-size: 54rpx;
  line-height: 1.18;
  text-align: center;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.acceptance-line {
  width: 96rpx;
  height: 2rpx;
  margin: 34rpx 0 30rpx;
  background: var(--bronze);
  opacity: 0.65;
}

.acceptance-quote {
  max-width: 520rpx;
  color: var(--ink-soft);
  font-size: 34rpx;
  line-height: 1.45;
  text-align: center;
}

.acceptance-button {
  margin-top: 54rpx;
}

@keyframes acceptance-fade {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes acceptance-rise {
  0% {
    opacity: 0;
    transform: translateY(20rpx) scale(0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ========== Library ========== */
.library-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bronze-line);
}

.library-group {
  margin-top: 20rpx;
}

.library-group-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.library-item > view {
  min-width: 0;
  flex: 1;
}

.library-text {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.library-item .danger-button {
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 16rpx;
  border: 2rpx solid rgba(196, 61, 61, 0.25);
  color: rgba(196, 61, 61, 0.85);
  background: rgba(196, 61, 61, 0.04);
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
